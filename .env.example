# =============================================================================
# Be-Found.online — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# =============================================================================

# --- Railway PostgreSQL ---
DATABASE_URL="postgresql://user:password@host:port/database"

# --- TransIP SMTP ---
SMTP_HOST="smtp.transip.email"
SMTP_PORT="465"
SMTP_USER="hello@b-found.online"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Be-Found <hello@b-found.online>"

# --- Page analysis (/analyze) — GEO-Score white-label API ---
# Server-side only; never prefix with NEXT_PUBLIC_. gs_test_ keys return fixed fixtures.
PAGE_ANALYSIS_API_KEY="gs_test_..."
# PAGE_ANALYSIS_API_BASE="https://api.geo-score.online/v1"

# --- Cloudflare Turnstile (required: /analyze refuses analyses without it) ---
# Local dev: Cloudflare's always-pass test keys
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Abuse limits for /analyze (defaults shown) ---
# ANALYZE_LIMIT_PER_IP_HOUR="3"
# ANALYZE_LIMIT_PER_DAY="300"
# Secret for hashing visitor IPs (falls back to PAGE_ANALYSIS_API_KEY)
ANALYZE_IP_SALT="change-me-random-string"
